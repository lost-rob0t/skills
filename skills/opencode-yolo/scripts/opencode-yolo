#!/usr/bin/env bash
set -euo pipefail

workspace="${OPENCODE_WORKSPACE:-$HOME/Documents/Projects/starintelV4}"
keep_context="${OPENCODE_KEEP_PROLOG_CONTEXT:-0}"
bootstrap=1
forward=()

usage() {
  cat <<'EOF'
usage: opencode-yolo [--yolo] [--workspace PATH] [--keep-context] [--no-bootstrap] [opencode TUI args...]

Launch OpenCode in auto-approve mode with a project-visible Prolog/spec context
backed by verified tmpfs.  --yolo is a wrapper alias for OpenCode --auto;
explicit OpenCode deny rules still apply.
EOF
}

while (($#)); do
  case "$1" in
    --yolo)
      shift
      ;;
    --workspace)
      (($# >= 2)) || { echo "opencode-yolo: --workspace requires a path" >&2; exit 2; }
      workspace="$2"
      shift 2
      ;;
    --workspace=*)
      workspace="${1#*=}"
      shift
      ;;
    --keep-context)
      keep_context=1
      shift
      ;;
    --no-bootstrap)
      bootstrap=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      forward+=("$1")
      shift
      ;;
  esac
done

workspace="$(realpath -e "$workspace")" || {
  echo "opencode-yolo: workspace does not exist: $workspace" >&2
  exit 1
}
[[ -d "$workspace" ]] || {
  echo "opencode-yolo: workspace is not a directory: $workspace" >&2
  exit 1
}

is_writable_tmpfs() {
  local path="$1"
  [[ -n "$path" && -d "$path" && -w "$path" ]] || return 1
  [[ "$(stat -f -c '%T' -- "$path" 2>/dev/null || true)" == "tmpfs" ]]
}

choose_tmpfs_root() {
  local candidate
  if [[ -n "${OPENCODE_TMPFS_ROOT:-}" ]]; then
    if is_writable_tmpfs "$OPENCODE_TMPFS_ROOT"; then
      realpath -e "$OPENCODE_TMPFS_ROOT"
      return 0
    fi
    echo "opencode-yolo: OPENCODE_TMPFS_ROOT is not a writable tmpfs: $OPENCODE_TMPFS_ROOT" >&2
    return 1
  fi

  for candidate in "${XDG_RUNTIME_DIR:-}" /dev/shm; do
    [[ -n "$candidate" ]] || continue
    if is_writable_tmpfs "$candidate"; then
      realpath -e "$candidate"
      return 0
    fi
  done

  echo "opencode-yolo: no writable tmpfs found (checked XDG_RUNTIME_DIR and /dev/shm)" >&2
  return 1
}

tmpfs_root="$(choose_tmpfs_root)"
context_real="$(mktemp -d "$tmpfs_root/prolog-tmp-spec-context.${UID:-$(id -u)}.XXXXXXXX")"
chmod 700 "$context_real"
mkdir -p "$context_real/tmp" "$context_real/spec"

context_view="$workspace/prolog-tmp-spec-context"

if [[ -L "$context_view" && ! -e "$context_view" ]]; then
  rm -- "$context_view"
fi
if [[ -e "$context_view" || -L "$context_view" ]]; then
  echo "opencode-yolo: refusing to replace existing workspace context path: $context_view" >&2
  rm -rf -- "$context_real"
  exit 1
fi
ln -s -- "$context_real" "$context_view"

cat >"$context_real/context.prolog" <<'PROLOG'
% Ephemeral Prolog-RLM working context created by opencode-yolo.
% This file lives on tmpfs.  Keep verified facts compact and provenance-aware.
:- dynamic requirement/1.
:- dynamic hypothesis/1.
:- dynamic needs_verification/1.
:- dynamic observed_fact/4.
:- dynamic decision/1.
:- dynamic decision_reason/2.
:- dynamic todo/1.
:- dynamic completed/1.
:- dynamic test_result/3.
:- dynamic proof_result/3.
PROLOG

cleanup() {
  local status=$?
  if [[ -L "$context_view" ]]; then
    local current_target
    current_target="$(readlink -f -- "$context_view" 2>/dev/null || true)"
    if [[ "$current_target" == "$context_real" ]]; then
      rm -f -- "$context_view"
    fi
  fi
  if [[ "$keep_context" == "1" ]]; then
    printf 'opencode-yolo: kept tmpfs context at %s\n' "$context_real" >&2
  else
    rm -rf -- "$context_real"
  fi
  return "$status"
}
trap cleanup EXIT

export OPENCODE_WORKSPACE="$workspace"
export STARINTEL_V4_ROOT="$workspace"
export PROLOG_TMP_SPEC_CONTEXT="$context_view"
export PROLOG_TMP_SPEC_CONTEXT_REAL="$context_real"
export TMPDIR="$context_real/tmp"
export OPENCODE_YOLO=1

spec_prompt="$workspace/spec.prompt.org"
if [[ -f "$spec_prompt" ]]; then
  export STARINTEL_SPEC_PROMPT="$spec_prompt"
else
  unset STARINTEL_SPEC_PROMPT 2>/dev/null || true
fi

opencode_bin="${OPENCODE_BIN:-}"
if [[ -z "$opencode_bin" ]]; then
  opencode_bin="$(command -v opencode || true)"
fi
[[ -n "$opencode_bin" && -x "$opencode_bin" ]] || {
  echo "opencode-yolo: OpenCode executable not found; set OPENCODE_BIN" >&2
  exit 127
}

has_auto=0
has_prompt=0
for arg in "${forward[@]}"; do
  [[ "$arg" == "--auto" ]] && has_auto=1
  [[ "$arg" == "--prompt" || "$arg" == --prompt=* ]] && has_prompt=1
done

args=()
(( has_auto )) || args+=(--auto)

if (( bootstrap && ! has_prompt )); then
  bootstrap_prompt="A private tmpfs Prolog/spec context is mounted at $context_view. Read ${STARINTEL_SPEC_PROMPT:-the workspace instructions} first when present. Before implementation load /spec, prolog-reasoning, and every applicable starintel* skill. Use $context_view/context.prolog as the live Prolog-RLM working KB: query it, identify missing knowledge, use the smallest repository/tool/subagent to verify that knowledge, assert compact facts with provenance, and query again. Put scratch specs and symbolic run context only under $context_view; do not commit this tmpfs context. Durable source changes remain in $workspace."
  args+=(--prompt "$bootstrap_prompt")
fi
args+=("${forward[@]}")

cd "$workspace"
printf 'opencode-yolo: workspace=%s\n' "$workspace" >&2
printf 'opencode-yolo: tmpfs-context=%s -> %s\n' "$context_view" "$context_real" >&2
"$opencode_bin" "${args[@]}"
